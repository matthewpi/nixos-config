From 56aea326039b9aabd1aa0474e343903245363401 Mon Sep 17 00:00:00 2001
From: Matthew Penner <me@matthewp.io>
Date: Fri, 8 May 2026 16:20:34 -0600
Subject: [PATCH 2/2] libblake3: ensure `useTBB` remains disabled

Signed-off-by: Matthew Penner <me@matthewp.io>
---
 packaging/dependencies.nix | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/packaging/dependencies.nix b/packaging/dependencies.nix
index c11c4149f..d65c64d5c 100644
--- a/packaging/dependencies.nix
+++ b/packaging/dependencies.nix
@@ -91,11 +91,11 @@ scope: {
       };
 
   libblake3 =
-    (pkgs.libblake3.override {
+    (pkgs.libblake3.override (oldAttrs: {
       inherit stdenv;
       # Nixpkgs disables tbb on static
-      useTBB = !(stdenv.hostPlatform.isWindows || stdenv.hostPlatform.isStatic);
-    })
+      useTBB = oldAttrs.useTBB && !(stdenv.hostPlatform.isWindows || stdenv.hostPlatform.isStatic);
+    }))
     # For some reason that is not clear, it is wanting to use libgcc_eh which is not available.
     # Force this to be built with compiler-rt & libunwind over libgcc_eh works.
     # Issue: https://github.com/NixOS/nixpkgs/issues/177129
-- 
2.53.0

